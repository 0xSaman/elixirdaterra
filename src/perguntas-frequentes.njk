---
layout: layouts/base.njk
permalink: /perguntas-frequentes/
title: Perguntas frequentes
description: "Dúvidas sobre o Extrato de Cúrcuma Elixir da Terra: como usar, composição, cuidados, frete, prazo de entrega, pagamento e trocas. Respostas rápidas."
seoTitle: "Perguntas frequentes | Elixir da Terra"
---
{%- from "partials/icons.njk" import icon -%}
{%- set groups = ["Produto", "Pedidos e entrega", "Pagamento", "Trocas"] -%}
{%- set gicons = {"Produto":"leaf","Pedidos e entrega":"truck","Pagamento":"card","Trocas":"return"} -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for item in faq %}{"@type":"Question","name":{{ item.q | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ item.a | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>

<section class="help-hero">
  <div class="wrap wrap--narrow">
    <span class="eyebrow">Central de ajuda</span>
    <h1 class="h-lg">Como podemos ajudar?</h1>
    <label class="help-search">
      {{ icon("search", 20) }}
      <input type="search" id="faq-search" placeholder="Busque por frete, uso, validade…" aria-label="Buscar nas perguntas" autocomplete="off">
    </label>
    <div class="help-tabs" role="tablist" aria-label="Categorias">
      <button type="button" role="tab" class="help-tab is-active" data-faq-tab="all" aria-selected="true">Todas</button>
      {%- for g in groups %}
      <button type="button" role="tab" class="help-tab" data-faq-tab="{{ g | slugify }}" aria-selected="false">{{ icon(gicons[g], 16) }} {{ g }}</button>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--tight">
  <div class="wrap wrap--narrow">
    {%- for g in groups %}
    <div class="help-group" data-faq-group="{{ g | slugify }}">
      <h2 class="help-group__title">{{ icon(gicons[g], 18, 1.8) }} {{ g }}</h2>
      <div class="faq-v3__list">
        {%- for item in faq %}{% if item.group == g %}
        <details class="faq-v3__item" data-q="{{ (item.q + ' ' + item.a) | striptags | lower }}">
          <summary><span>{{ item.q }}</span><i aria-hidden="true"></i></summary>
          <div class="faq-v3__a">{{ item.a | safe }}</div>
        </details>
        {%- endif %}{% endfor %}
      </div>
    </div>
    {%- endfor %}
    <p class="help-empty" id="faq-empty" hidden>Nenhuma pergunta encontrada. Tente outra palavra ou fale com a gente.</p>

    <div class="help-contact">
      <span class="help-contact__ic">{{ icon("whatsapp", 24) }}</span>
      <div>
        <h2>Ainda com dúvida?</h2>
        <p>Fale com a gente no WhatsApp. Respondemos rápido.</p>
      </div>
      <a class="btn btn--wa" href="https://wa.me/{{ site.whatsapp }}?text={{ 'Olá! Tenho uma dúvida sobre o Elixir da Terra.' | urlencode }}" target="_blank" rel="noopener">{{ icon("whatsapp", 18) }} Falar no WhatsApp</a>
    </div>
  </div>
</section>

<script>
(function () {
  var tabs = [].slice.call(document.querySelectorAll("[data-faq-tab]")), groups = [].slice.call(document.querySelectorAll("[data-faq-group]"));
  var input = document.getElementById("faq-search"), empty = document.getElementById("faq-empty"), cur = "all";
  function norm(s) { return String(s).toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, ""); }
  function apply() {
    var q = norm(input.value.trim()), any = false;
    groups.forEach(function (g) {
      var inTab = cur === "all" || g.getAttribute("data-faq-group") === cur, shown = 0;
      g.querySelectorAll("details").forEach(function (d) {
        var ok = inTab && (!q || norm(d.getAttribute("data-q")).indexOf(q) > -1);
        d.hidden = !ok; if (ok) shown++;
        if (q && ok) d.open = true;
      });
      g.hidden = !shown; if (shown) any = true;
    });
    empty.hidden = any;
  }
  tabs.forEach(function (t) {
    t.addEventListener("click", function () {
      cur = t.getAttribute("data-faq-tab");
      tabs.forEach(function (x) { var on = x === t; x.classList.toggle("is-active", on); x.setAttribute("aria-selected", on ? "true" : "false"); });
      apply();
    });
  });
  input.addEventListener("input", apply);
})();
</script>
