---
layout: layouts/base.njk
ogType: article
---
{%- from "partials/icons.njk" import icon -%}
{%- set pct = catalog.settings.pixDiscountPercent -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[
{"@type":"BlogPosting","headline":{{ title | json | safe }},"description":{{ description | json | safe }},"image":"{{ image | absUrl(site.url) }}","datePublished":"{{ page.date | isoDate }}","dateModified":"{{ (updated or page.date) | isoDate }}","inLanguage":"pt-BR","mainEntityOfPage":"{{ page.url | absUrl(site.url) }}","author":{"@type":"Organization","name":"{{ site.name }}","url":"{{ site.url }}/"},"publisher":{"@id":"{{ site.url }}/#org"}},
{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Início","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"Blog","item":"{{ site.url }}/blog/"},{"@type":"ListItem","position":3,"name":{{ title | json | safe }},"item":"{{ page.url | absUrl(site.url) }}"}]}
]}
</script>
<div class="wrap">
  <nav class="breadcrumbs" aria-label="Você está em"><ol><li><a href="/">Início</a></li><li><a href="/blog/">Blog</a></li><li aria-current="page">{{ category }}</li></ol></nav>
  <header class="article-head">
    <span class="eyebrow">{{ category }}</span>
    <h1 class="h-lg">{{ title }}</h1>
    <p class="lead">{{ description }}</p>
    <div class="article-meta">
      <span class="hide-sm">Por {{ site.name }}</span><span class="hide-sm">·</span>
      <time datetime="{{ page.date | isoDate }}">{{ page.date | dateBR }}</time><span>·</span>
      <span>{{ content | readingTime }} min de leitura</span>
    </div>
  </header>
  <figure class="article-cover"><img src="{{ image }}" alt="{{ imageAlt }}" width="1200" height="514"></figure>
  <div class="article-layout">
    <article class="prose">
{{ content | safe }}
      <p class="note">Este conteúdo é informativo e não substitui a orientação de um médico ou nutricionista. Antes de usar qualquer suplemento, principalmente se você estiver gestante, amamentando ou usando medicamentos, converse com um profissional de saúde.</p>
    </article>
    <aside class="article-aside" aria-label="Produto">
      <div class="aside-card">
        <img src="/assets/img/frasco-estudio.webp" alt="Frasco do Extrato de Cúrcuma Elixir da Terra" loading="lazy" width="300" height="225">
        <div>
          <b>{{ catalog.product.name }} {{ catalog.product.size }}</b>
          <span class="muted" style="font-size:14px">A partir de {{ catalog.minPrice | brl }}</span>
          <a class="btn btn--primary btn--block btn--sm" href="/extrato-de-curcuma/">Conhecer o extrato</a>
        </div>
      </div>
    </aside>
  </div>
</div>
<section class="section">
  <div class="wrap">
    <div class="section-head"><div><span class="eyebrow">Continue lendo</span><h2 class="h-md">Leia também</h2></div><a class="link-arrow" href="/blog/">Ver o blog {{ icon("arrow", 16) }}</a></div>
    <div class="post-grid">
      {%- for post in collections.posts | related(page.url, category, 3) %}{% include "partials/post-card.njk" %}{% endfor %}
    </div>
  </div>
</section>
