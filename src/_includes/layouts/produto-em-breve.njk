---
layout: layouts/base.njk
---
{#- Molde de página de produto "em breve" (lista de espera).
    Uso: crie src/produtos/<slug>.njk com "layout: layouts/produto-em-breve.njk" e "produto: <slug>",
    e o conteúdo em src/_data/produtos/<slug>.js. Seções opcionais aparecem só se existirem no arquivo de dados. -#}
{%- from "partials/icons.njk" import icon -%}
{%- set d = produtos[produto] -%}
{%- set p = d.product -%}
{%- set gallery = d.gallery -%}
{%- macro refs(list) -%}{% if list and list.length %}<sup class="pe-ref">{% for n in list %}<a href="#fonte-{{ n }}" aria-label="Fonte {{ n }}">{{ n }}</a>{% if not loop.last %},{% endif %}{% endfor %}</sup>{% endif %}{%- endmacro -%}

{%- if d.faq %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for item in d.faq %}{"@type":"Question","name":{{ item.q | json | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ item.a | json | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
{%- endif %}

<div class="wrap">
  <nav class="breadcrumbs" aria-label="Você está em"><ol><li><a href="/">Início</a></li><li aria-current="page">{{ p.shortName }}</li></ol></nav>

  <div class="pdp">
    <!-- Galeria -->
    <div class="gallery" id="gallery">
      <div class="gallery__main">
        <img id="gallery-main" src="{{ gallery[0].src }}" alt="{{ gallery[0].alt }}" width="{{ gallery[0].w }}" height="{{ gallery[0].h }}" fetchpriority="high">
        <span class="zoom-lens" id="zoom-lens" aria-hidden="true"></span>
        {%- if d.illustrations !== false %}<span class="pe-illus-tag">Ilustração</span>{% endif %}
        <button class="gallery__zoom" type="button" id="open-lightbox" aria-label="Ampliar imagem">{{ icon("search", 20) }}</button>
        <button class="gallery__nav gallery__nav--prev" type="button" aria-label="Imagem anterior" data-gal="-1">{{ icon("chev-left", 20) }}</button>
        <button class="gallery__nav gallery__nav--next" type="button" aria-label="Próxima imagem" data-gal="1">{{ icon("chev-right", 20) }}</button>
      </div>
      <div class="gallery__thumbs" role="list" aria-label="Imagens do produto">
        {%- for g in gallery %}
        <button type="button" role="listitem" data-src="{{ g.src }}" data-alt="{{ g.alt }}" aria-label="Ver imagem {{ loop.index }}" aria-current="{{ 'true' if loop.first else 'false' }}"><img src="{{ g.src }}" alt="" loading="lazy" width="68" height="68"></button>
        {%- endfor %}
      </div>
    </div>

    <!-- Lista de espera -->
    <div class="buybox">
      <div class="buybox__title">
        <span class="buybox__brand">{{ p.brand }}</span>
        <h1>{{ p.name }} <span class="buybox__size">{{ p.size }}</span></h1>
        <p class="buybox__sub">{{ p.tagline }}</p>
        {%- if p.tags %}<ul class="buybox__tags">{% for t in p.tags %}<li>{{ t }}</li>{% endfor %}</ul>{% endif %}
      </div>

      <div class="buybox__price">
        <div class="price-row">
          <span class="badge badge--soon">{{ icon("clock", 14, 2.4) }} Em breve</span>
          <span class="price">Lançamento em breve</span>
        </div>
        <span class="inst">Entre na lista de espera e seja avisado primeiro.</span>
      </div>

      <form id="wait-form" class="stack" method="POST" action="/api/form" data-nome="{{ p.shortName }}" novalidate>
        <input type="hidden" name="form-name" value="lista-espera">
        <input type="hidden" name="produto" value="{{ d.slug }}">
        <p hidden><label>Não preencha: <input name="empresa" tabindex="-1" autocomplete="off"></label></p>
        {%- if d.kits %}
        <fieldset style="border:0;margin:0;padding:0">
          <legend class="fieldset-label">Qual kit te interessa?</legend>
          <div class="variant-list" role="radiogroup">
            {%- for k in d.kits %}
            <label class="variant{% if loop.first %} is-selected{% endif %}" data-variant="{{ k.id }}"{% if k.image is defined %} data-image="{{ k.image }}"{% endif %}>
              <input type="radio" name="kit" value="{{ k.id }}" {% if loop.first %}checked{% endif %}>
              <span class="dot" aria-hidden="true"></span>
              <span class="variant__main">
                <span class="variant__name">{{ k.name }}</span>
                <span class="variant__desc">{{ k.desc }}</span>
                {%- if k.free and catalog.settings.shipping.freeFromUnits %}<span class="variant__free">{{ icon("truck", 13) }} Frete grátis</span>{% endif %}
              </span>
              <span class="variant__price"><b class="pe-soon">Em breve</b></span>
              {%- if k.badge %}<span class="variant__tag variant__tag--wine">{{ k.badge }}</span>{% endif %}
            </label>
            {%- endfor %}
          </div>
          {%- if p.whatsappText %}
          <p class="variant-more">{{ icon("whatsapp", 15) }}<span>Quer reservar já?</span><a href="https://wa.me/{{ site.whatsapp }}?text={{ p.whatsappText | urlencode }}" target="_blank" rel="noopener">Fale no WhatsApp</a></p>
          {%- endif %}
        </fieldset>
        {%- endif %}

        <div class="pe-wait">
          <div class="field"><label for="w-nome">Seu nome <span class="muted">(opcional)</span></label><input id="w-nome" name="nome" autocomplete="given-name" maxlength="80"></div>
          <div class="field"><label for="w-contato">WhatsApp ou e-mail</label><input id="w-contato" name="contato" required autocomplete="email" inputmode="email" maxlength="120" placeholder="(48) 99999-9999 ou voce@email.com" aria-describedby="w-msg"><span class="field-msg" id="w-msg" aria-live="polite"></span></div>
        </div>
        <button class="btn btn--primary btn--block" type="submit" id="wait-btn">{{ icon("mail", 19) }} Avise-me quando chegar</button>
        <p class="pe-wait__ok" id="wait-ok" hidden role="status">{{ icon("check", 18, 2.4) }} <span>Pronto! Você está na lista e será avisado assim que o {{ p.shortName }} chegar.</span></p>
        <p class="field-hint">Usamos seu contato só para avisar do lançamento.</p>
      </form>

      <ul class="buybox__perks">
        <li>{{ icon("truck", 18, 1.8) }} <span>{% if catalog.settings.shipping.freeFromUnits %}<b>Frete grátis</b> a partir de {{ catalog.settings.shipping.freeFromUnits }} frascos{% else %}Envio com rastreio{% endif %}</span></li>
        <li>{{ icon("shield", 18, 1.8) }} <span><b>Pagamento seguro</b> Mercado Pago</span></li>
        <li>{{ icon("return", 18, 1.8) }} <span><b>7 dias</b> para devolução</span></li>
      </ul>

      <div class="accordion">
        <details open>
          <summary>Descrição</summary>
          <div class="acc-body">{% for t in p.description %}<p>{{ t | safe }}</p>{% endfor %}</div>
        </details>
        {%- if p.usage %}
        <details>
          <summary>Modo de uso</summary>
          <div class="acc-body"><p>{{ p.usage }}</p></div>
        </details>
        {%- endif %}
        <details>
          <summary>Composição e informações</summary>
          <div class="acc-body">
            <dl>
              {%- if p.composition %}<dt>Composição</dt><dd>{{ p.composition }}</dd>{% endif %}
              <dt>Conteúdo</dt><dd>{{ p.size }}</dd>
              {%- if p.shelfLife %}<dt>Validade</dt><dd>{{ p.shelfLife }}</dd>{% endif %}
              {%- if p.storage %}<dt>Conservação</dt><dd>{{ p.storage }}</dd>{% endif %}
              {%- if p.regulatory %}<dt>Registro</dt><dd>{{ p.regulatory }}</dd>{% endif %}
              <dt>Fabricante</dt><dd>{{ site.legal.company }} · CNPJ {{ site.legal.cnpj }}</dd>
            </dl>
          </div>
        </details>
        {%- if d.care %}
        <details>
          <summary>Cuidados</summary>
          <div class="acc-body">
            {%- for line in d.care %}<p>{{ line }}</p>{% endfor %}
            <p>Este produto não é um medicamento e não substitui orientação médica.{{ refs(d.careRefs) }}</p>
          </div>
        </details>
        {%- endif %}
      </div>
    </div>
  </div>
</div>

{%- if d.body %}
<!-- No corpo -->
<section class="section section--sand pe-body" id="no-corpo">
  <div class="wrap">
    <div class="section-head">
      <div>
        <span class="eyebrow">{{ d.body.eyebrow }}</span>
        <h2 class="h-lg">{{ d.body.title }}</h2>
        {%- if d.body.lead %}<p class="lead">{{ d.body.lead }}</p>{% endif %}
      </div>
    </div>
    <div class="pe-cards">
      {%- for b in d.body.cards %}
      <article class="pe-card">
        <span class="pe-card__ic">{{ icon(b.icon, 22, 1.9) }}</span>
        <span class="pe-card__tag">{{ b.tag }}</span>
        <h3 class="h-sm">{{ b.title }}</h3>
        <p>{{ b.text }}{{ refs(b.refs) }}</p>
      </article>
      {%- endfor %}
    </div>
    {%- if d.body.disclaimer %}<p class="pe-disclaimer">{{ d.body.disclaimer }}</p>{% endif %}
  </div>
</section>
{%- endif %}

{%- if d.spirit %}
<!-- Dimensão energética -->
<section class="section pe-spirit" id="dimensao-energetica">
  <div class="wrap pe-spirit__grid">
    <div class="pe-spirit__copy">
      <span class="eyebrow">{{ d.spirit.eyebrow }}</span>
      <h2 class="h-lg">{{ d.spirit.title }}</h2>
      {%- for t in d.spirit.intro %}<p>{{ t.t }}{{ refs(t.refs) }}</p>{% endfor %}
    </div>
    <div class="pe-pillars">
      {%- for pl in d.spirit.pillars %}
      <div class="pe-pillar">
        <span class="pe-pillar__n">{{ loop.index }}</span>
        <h3>{{ pl.title }}</h3>
        <p>{{ pl.text }}{{ refs(pl.refs) }}</p>
      </div>
      {%- endfor %}
    </div>
    {%- if d.spirit.notes or d.spirit.small %}
    <div class="pe-spirit__notes">
      {%- for n in d.spirit.notes %}<p>{{ icon("leaf", 16, 2) }}<span>{{ n.t }}{{ refs(n.refs) }}</span></p>{% endfor %}
      {%- if d.spirit.small %}<p class="pe-spirit__small">{{ d.spirit.small }}</p>{% endif %}
    </div>
    {%- endif %}
  </div>
</section>
{%- endif %}

{%- if d.plant %}
<!-- A planta -->
<section class="section pe-plant" id="a-planta">
  <div class="wrap pe-plant__grid">
    <figure class="pe-plant__img">
      <img src="{{ d.plant.image.src }}" alt="{{ d.plant.image.alt }}" width="{{ d.plant.image.w }}" height="{{ d.plant.image.h }}" loading="lazy">
    </figure>
    <div>
      <span class="eyebrow">{{ d.plant.eyebrow }}</span>
      <h2 class="h-lg">{{ d.plant.title }}</h2>
      <dl class="pe-facts">
        {%- for f in d.plant.facts %}
        <div><dt>{{ f.k }}</dt><dd>{{ f.v | safe }}{{ refs(f.refs) }}</dd></div>
        {%- endfor %}
      </dl>
      {%- if d.plant.note %}<p class="pe-note">{{ icon("search", 16, 2) }}<span>{{ d.plant.note.t | safe }}{{ refs(d.plant.note.refs) }}</span></p>{% endif %}
    </div>
  </div>
</section>
{%- endif %}

{%- if d.faq %}
<!-- Perguntas -->
<section class="section faq-v3">
  <div class="wrap wrap--narrow">
    <div class="section-head section-head--center">
      <div>
        <span class="eyebrow">Dúvidas</span>
        <h2 class="h-lg">{{ d.faqTitle or "Perguntas frequentes" }}</h2>
      </div>
    </div>
    <div class="faq-v3__list">
      {%- for item in d.faq %}
      <details class="faq-v3__item">
        <summary><span>{{ item.q }}</span><i aria-hidden="true"></i></summary>
        <div class="faq-v3__a">{{ item.a }}</div>
      </details>
      {%- endfor %}
    </div>
    <div class="faq-v3__foot">
      <p>Não encontrou o que procurava?</p>
      <div>
        <a class="btn btn--wa btn--sm" href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener">{{ icon("whatsapp", 16) }} Falar no WhatsApp</a>
        <a class="link-arrow" href="#wait-form">Entrar na lista de espera {{ icon("arrow", 16) }}</a>
      </div>
    </div>
  </div>
</section>
{%- endif %}

{%- if d.references %}
<!-- Fontes -->
<section class="section section--tight pe-refs" id="fontes">
  <div class="wrap wrap--narrow">
    <details>
      <summary><span class="h-sm">Fontes consultadas</span><span class="muted">{{ d.references | length }} referências</span></summary>
      <ol>
        {%- for r in d.references %}
        <li id="fonte-{{ r.n }}" value="{{ r.n }}"><a href="{{ r.u }}" target="_blank" rel="noopener">{{ r.t }}</a> <span class="muted">— {{ r.s }}</span></li>
        {%- endfor %}
      </ol>
    </details>
  </div>
</section>
{%- endif %}

<div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Imagens ampliadas">
  <button class="lightbox__close" type="button" data-lb-close aria-label="Fechar">{{ icon("close", 26) }}</button>
  <button class="lightbox__nav lightbox__nav--prev" type="button" data-lb="-1" aria-label="Imagem anterior">{{ icon("chev-left", 28) }}</button>
  <figure class="lightbox__stage"><img id="lightbox-img" alt=""></figure>
  <button class="lightbox__nav lightbox__nav--next" type="button" data-lb="1" aria-label="Próxima imagem">{{ icon("chev-right", 28) }}</button>
  <p class="lightbox__count" id="lightbox-count"></p>
</div>

<div class="buybar" id="buybar" aria-hidden="true">
  <div class="buybar__info"><b>{{ p.shortName }} · em breve</b><span>Entre na lista de espera</span></div>
  <button class="btn btn--primary" type="button" id="buybar-btn" tabindex="-1">Avise-me</button>
</div>
