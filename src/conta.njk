---
layout: layouts/base.njk
permalink: /conta/
title: Minha conta
seoTitle: "Minha conta | Elixir da Terra"
description: "Entre ou crie sua conta no Elixir da Terra para acompanhar seus pedidos, ver compras anteriores, comprar de novo com um clique e salvar seu endereço."
noindex: true
scripts: ["/assets/js/account.js"]
---
{%- from "partials/icons.njk" import icon -%}
<section class="acc">
  <div class="wrap">

    <!-- Entrar / cadastrar -->
    <div class="acc-auth" id="acc-auth" hidden>
      <div class="acc-auth__side">
        <span class="eyebrow eyebrow--light">Área do cliente</span>
        <h1>Sua conta <em>Elixir da Terra</em></h1>
        <ul class="acc-auth__perks">
          <li>{{ icon("package", 20, 1.8) }}<span><b>Acompanhe seus pedidos</b><small>Status, rastreio e histórico em um só lugar.</small></span></li>
          <li>{{ icon("return", 20, 1.8) }}<span><b>Compre de novo com um clique</b><small>Seu kit favorito volta para o carrinho na hora.</small></span></li>
          <li>{{ icon("truck", 20, 1.8) }}<span><b>Checkout mais rápido</b><small>Seus dados e endereço já preenchidos.</small></span></li>
          <li>{{ icon("shield", 20, 1.8) }}<span><b>Dados protegidos</b><small>Senha criptografada e conexão segura.</small></span></li>
        </ul>
      </div>
      <div class="acc-auth__card">
        <div class="acc-tabs" role="tablist">
          <button type="button" role="tab" class="acc-tab is-active" data-auth-tab="login" aria-selected="true">Entrar</button>
          <button type="button" role="tab" class="acc-tab" data-auth-tab="register" aria-selected="false">Criar conta</button>
        </div>
        <form id="login-form" class="acc-form" novalidate>
          <div class="field"><label for="l-email">E-mail</label><input id="l-email" type="email" autocomplete="email" required maxlength="160"></div>
          <div class="field"><label for="l-pass">Senha</label>
            <div class="pass-wrap"><input id="l-pass" type="password" autocomplete="current-password" required maxlength="128"><button type="button" class="pass-eye" data-eye="l-pass" aria-label="Mostrar senha">Mostrar</button></div>
          </div>
          <p class="acc-msg" id="login-msg" role="alert"></p>
          <button class="btn btn--primary btn--block" type="submit">Entrar</button>
          <p class="acc-help">Esqueceu a senha? <button type="button" class="link-btn" id="forgot-open" hidden>Redefinir por e-mail</button><a id="forgot-wa" href="https://wa.me/{{ site.whatsapp }}?text={{ 'Olá! Esqueci a senha da minha conta no site.' | urlencode }}" target="_blank" rel="noopener">Fale com a gente</a></p>
        </form>
        <form id="forgot-form" class="acc-form" novalidate hidden>
          <p class="muted" style="font-size:14px">Enviaremos um código de 6 dígitos para o seu e-mail.</p>
          <div class="field"><label for="f-email">E-mail da conta</label><input id="f-email" type="email" autocomplete="email" maxlength="160"></div>
          <div class="field" data-reset-step hidden><label for="f-code">Código recebido</label><input id="f-code" inputmode="numeric" maxlength="6" placeholder="000000"></div>
          <div class="field" data-reset-step hidden><label for="f-pass">Nova senha</label><input id="f-pass" type="password" autocomplete="new-password" maxlength="128"><p class="field-hint">Mínimo de 8 caracteres, com letras e números.</p></div>
          <p class="acc-msg" id="forgot-msg" role="alert"></p>
          <button class="btn btn--primary btn--block" type="submit" id="forgot-btn">Enviar código</button>
          <p class="acc-help"><button type="button" class="link-btn" id="forgot-back">Voltar para entrar</button></p>
        </form>
        <form id="newpass-form" class="acc-form" novalidate hidden>
          <h2 class="h-sm">Criar nova senha</h2>
          <p class="muted" style="font-size:14px">Conta: <b id="np-email"></b></p>
          <div class="field"><label for="np-pass">Nova senha</label><input id="np-pass" type="password" autocomplete="new-password" maxlength="128" required><p class="field-hint">Mínimo de 8 caracteres, com letras e números.</p></div>
          <p class="acc-msg" id="np-msg" role="alert"></p>
          <button class="btn btn--primary btn--block" type="submit">Salvar e entrar</button>
        </form>
        <form id="register-form" class="acc-form" novalidate hidden>
          <div class="field"><label for="r-name">Nome completo</label><input id="r-name" autocomplete="name" required maxlength="100"></div>
          <div class="field"><label for="r-email">E-mail</label><input id="r-email" type="email" autocomplete="email" required maxlength="160"></div>
          <div class="field"><label for="r-phone">Celular (WhatsApp) <span class="opt">(opcional)</span></label><input id="r-phone" type="tel" inputmode="numeric" autocomplete="tel" maxlength="16" placeholder="(00) 00000-0000"></div>
          <div class="field"><label for="r-pass">Crie uma senha</label>
            <div class="pass-wrap"><input id="r-pass" type="password" autocomplete="new-password" required maxlength="128"><button type="button" class="pass-eye" data-eye="r-pass" aria-label="Mostrar senha">Mostrar</button></div>
            <p class="field-hint">Mínimo de 8 caracteres, com letras e números.</p>
          </div>
          <p class="acc-msg" id="register-msg" role="alert"></p>
          <button class="btn btn--primary btn--block" type="submit">Criar minha conta</button>
          <p class="acc-help">Ao criar a conta você concorda com os <a href="/politicas/termos-de-uso/">Termos de uso</a> e a <a href="/politicas/privacidade/">Política de privacidade</a>.</p>
        </form>
      </div>
    </div>

    <!-- Painel do cliente -->
    <div class="acc-dash" id="acc-dash" hidden>
      <div class="acc-head">
        <div class="acc-head__avatar" id="acc-avatar" aria-hidden="true">E</div>
        <div><span class="muted">Olá,</span><h1 id="acc-hello">cliente</h1></div>
        <button class="btn btn--outline btn--sm" type="button" id="acc-logout">Sair</button>
      </div>
      <div class="acc-verify" id="acc-verify" hidden>
        <span>{{ icon("mail", 20, 1.8) }}</span>
        <p><b>Confirme seu e-mail</b> para ver automaticamente todas as compras feitas com ele.</p>
        <button class="btn btn--dark btn--sm" type="button" id="acc-send-code">Enviar código</button>
        <form id="acc-code-form" hidden><input id="acc-code" inputmode="numeric" maxlength="6" placeholder="000000" aria-label="Código"><button class="btn btn--primary btn--sm" type="submit">Confirmar</button></form>
      </div>

      <div class="acc-layout">
        <nav class="acc-nav" aria-label="Minha conta">
          <button type="button" class="is-active" data-pane="orders">{{ icon("package", 18) }} Meus pedidos</button>
          <button type="button" data-pane="profile">{{ icon("hand", 18) }} Meus dados</button>
          <button type="button" data-pane="address">{{ icon("truck", 18) }} Endereço</button>
          <button type="button" data-pane="security">{{ icon("lock", 18) }} Senha</button>
        </nav>

        <div class="acc-panes">
          <section class="acc-pane" data-pane-body="orders">
            <div class="acc-pane__head"><h2>Meus pedidos</h2></div>
            <div id="acc-orders"></div>
            <details class="acc-link">
              <summary>Não encontrou um pedido? Vincule pelo número</summary>
              <form id="link-form" class="acc-inline">
                <input id="link-order" placeholder="EDT-XXXXXXXX" maxlength="24" autocapitalize="characters" aria-label="Número do pedido">
                <input id="link-email" type="email" placeholder="E-mail usado na compra" maxlength="160" aria-label="E-mail da compra">
                <button class="btn btn--dark btn--sm" type="submit">Vincular</button>
              </form>
              <p class="acc-msg" id="link-msg" role="alert"></p>
            </details>
          </section>

          <section class="acc-pane" data-pane-body="profile" hidden>
            <div class="acc-pane__head"><h2>Meus dados</h2></div>
            <form id="profile-form" class="acc-form acc-form--grid" novalidate>
              <div class="field"><label for="p-name">Nome completo</label><input id="p-name" autocomplete="name" maxlength="100"></div>
              <div class="field"><label for="p-email">E-mail</label><input id="p-email" type="email" disabled></div>
              <div class="field"><label for="p-phone">Celular (WhatsApp)</label><input id="p-phone" type="tel" inputmode="numeric" maxlength="16"></div>
              <div class="field"><label for="p-cpf">CPF</label><input id="p-cpf" inputmode="numeric" maxlength="14" placeholder="000.000.000-00"><p class="field-hint" id="p-cpf-hint"></p></div>
              <p class="acc-msg" id="profile-msg" role="alert"></p>
              <button class="btn btn--primary" type="submit">Salvar dados</button>
            </form>
          </section>

          <section class="acc-pane" data-pane-body="address" hidden>
            <div class="acc-pane__head"><h2>Endereço de entrega</h2><p class="muted">Usado para preencher o checkout automaticamente.</p></div>
            <form id="address-form" class="acc-form acc-form--grid" novalidate>
              <div class="field"><label for="a-cep">CEP</label><input id="a-cep" inputmode="numeric" maxlength="9" autocomplete="postal-code" placeholder="00000-000"></div>
              <div class="field field--wide"><label for="a-street">Endereço</label><input id="a-street" autocomplete="address-line1" maxlength="120"></div>
              <div class="field"><label for="a-number">Número</label><input id="a-number" maxlength="20"></div>
              <div class="field"><label for="a-complement">Complemento <span class="opt">(opcional)</span></label><input id="a-complement" maxlength="80"></div>
              <div class="field"><label for="a-district">Bairro</label><input id="a-district" maxlength="80"></div>
              <div class="field"><label for="a-city">Cidade</label><input id="a-city" maxlength="80"></div>
              <div class="field"><label for="a-uf">UF</label><select id="a-uf"><option value="">—</option>{% for uf in ["AC","AL","AP","AM","BA","CE","DF","ES","GO","MA","MT","MS","MG","PA","PB","PR","PE","PI","RJ","RN","RS","RO","RR","SC","SP","SE","TO"] %}<option>{{ uf }}</option>{% endfor %}</select></div>
              <p class="acc-msg" id="address-msg" role="alert"></p>
              <button class="btn btn--primary" type="submit">Salvar endereço</button>
            </form>
          </section>

          <section class="acc-pane" data-pane-body="security" hidden>
            <div class="acc-pane__head"><h2>Alterar senha</h2><p class="muted">Ao trocar a senha, outros aparelhos conectados saem da conta.</p></div>
            <form id="password-form" class="acc-form" novalidate style="max-width:420px">
              <div class="field"><label for="s-current">Senha atual</label><input id="s-current" type="password" autocomplete="current-password" maxlength="128"></div>
              <div class="field"><label for="s-new">Nova senha</label><input id="s-new" type="password" autocomplete="new-password" maxlength="128"><p class="field-hint">Mínimo de 8 caracteres, com letras e números.</p></div>
              <p class="acc-msg" id="password-msg" role="alert"></p>
              <button class="btn btn--primary" type="submit">Alterar senha</button>
            </form>
          </section>
        </div>
      </div>
    </div>

    <div class="acc-loading" id="acc-loading"><span class="spinner" aria-hidden="true"></span> Carregando sua conta…</div>
  </div>
</section>
